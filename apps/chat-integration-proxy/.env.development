# PostgreSQL connection for local development and tests.
# Provided by the `postgres` service in .devcontainer/compose.yml (task 1.2).
# Read only by src/runtime/config.ts once it exists (task 1.5) -- "the only
# place allowed to read env vars" per design.md. Until then, the connectivity
# test in src/postgres-connectivity.integ.ts reads it directly.
#
# Used for this app's own tables (Prisma, task 1.4). Prisma defaults to the
# `public` schema when the URL has no `?schema=` parameter, which is fine here
# since the Chat SDK state adapter lives in its own `chat_sdk` schema instead
# (see CHAT_SDK_DATABASE_URL below).
DATABASE_URL="postgresql://chat_integration_proxy:chat_integration_proxy_dev@postgres:5432/chat_integration_proxy"

# Connection URL for `@chat-adapter/state-pg` (Chat SDK's distributed-lock /
# dedup / subscription state; design.md decision 6). Same PostgreSQL instance,
# different schema: `@chat-adapter/state-pg` has no schema option of its own
# (createPostgresState() only accepts url / client / keyPrefix / logger), so
# schema separation is done via the standard libpq `options` connection
# parameter, which `pg` forwards verbatim as a startup option: `-c
# search_path=chat_sdk` makes every table state-pg auto-creates land in the
# `chat_sdk` schema (created ahead of time by postgres-init in compose.yml)
# instead of `public`, where this app's own Prisma tables live.
#
# IMPORTANT for task 1.4/1.5: do NOT name this env var DATABASE_URL or
# POSTGRES_URL. `createPostgresState()` auto-detects both of those names from
# process.env when called with no `url` option, which would collide with the
# app's own Prisma DATABASE_URL above. Pass this value explicitly as
# `createPostgresState({ url: ... })` (or build a `pg.Pool` explicitly and
# pass `{ client }`) rather than relying on auto-detection.
CHAT_SDK_DATABASE_URL="postgresql://chat_integration_proxy:chat_integration_proxy_dev@postgres:5432/chat_integration_proxy?options=-c%20search_path%3Dchat_sdk"

# ---------------------------------------------------------------------------
# Read by src/runtime/config.ts (task 1.5) -- the only file in src/ allowed to
# read env vars. Everything below is a development-only placeholder.
# ---------------------------------------------------------------------------

# Encrypts `installation.credentials` and `own_key.private_key_pem` before they
# are stored (design.md, Data Models). 32 random bytes, base64-encoded:
#   openssl rand -base64 32
# The proxy refuses to start when this is unset or decodes to another length --
# storing those columns in the clear is not an option it falls back to.
SECRET_ENCRYPTION_KEY="ZGV2ZWxvcG1lbnQtb25seS1rZXktMzItYnl0ZXMhISE="

# Per-app credentials (`PlatformAppConfig`). A service is configured as a whole
# or left out entirely: set every variable of a block, or none of them, and the
# service is simply absent from this deployment. All four blocks are commented
# out here because local development needs no live connection.
#
#SLACK_SIGNING_SECRET=""
#SLACK_CLIENT_ID=""
#SLACK_CLIENT_SECRET=""
# App-level token (`xapp-` prefixed); opens the Socket Mode connection.
#SLACK_APP_TOKEN=""
#
#DISCORD_APPLICATION_ID=""
#DISCORD_PUBLIC_KEY=""
#DISCORD_CLIENT_SECRET=""
# Opens the Gateway connection; one per app, not per joined server.
#DISCORD_BOT_TOKEN=""
#
#TEAMS_CLIENT_ID=""
#TEAMS_CLIENT_SECRET=""

# Closed-network destinations (requirement 13.1). A JSON list; each entry names
# a bare hostname -- no scheme, port or path, because that is what the declared
# GROWI URL is matched by (`judgeGrowiUri`'s allowList). A listed host passes the
# https / default-port / private-address checks together, which is what lets a
# GROWI inside a closed network be paired at all.
#
# `caCertPath` is optional and points at a PEM certificate to trust when
# connecting to that host. Closed networks commonly use a private CA or a
# self-signed certificate; without a way to name one, the only working setup
# would be turning certificate verification off entirely. The file is read at
# startup, so a wrong path stops the process instead of failing a pairing later.
#
#GROWI_ALLOWED_DESTINATIONS='[{"hostname":"growi.internal","caCertPath":"/etc/chat-integration-proxy/internal-ca.pem"},{"hostname":"wiki.example.local"}]'
