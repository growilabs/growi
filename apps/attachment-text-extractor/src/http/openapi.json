{
  "openapi": "3.1.0",
  "info": {
    "title": "Attachment Text Extractor",
    "description": "Attachment text extraction microservice for GROWI.",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness probe",
        "description": "Return 200 OK to confirm the process is alive.\n\nThis handler intentionally does no dependency checking — it exists only\nto tell the orchestrator that the process has not crashed.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": ["health"],
        "summary": "Readiness probe",
        "description": "200 `ready` when `prlimit` can be run and a probe child process starts, else 503 `not_ready`.\n\nThe body never carries paths or exception text.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/extract": {
      "post": {
        "tags": ["extract"],
        "summary": "Extract text from an uploaded file",
        "description": "Receive a multipart upload, enforce the slot and size limits, then convert it in a child process.\n\nThe Bearer token is checked before this operation runs; only authenticated requests reach it.",
        "operationId": "post_extract_extract_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_post_extract_extract_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported file format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "Extraction timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "File too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Encrypted, malformed or over-limit document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Extraction process failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "All concurrency slots are busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_post_extract_extract_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "File to extract text from"
          },
          "mimeType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mimetype",
            "description": "Optional MIME type hint"
          }
        },
        "type": "object",
        "required": ["file"],
        "title": "Body_post_extract_extract_post"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "unauthorized",
          "unsupported_format",
          "file_too_large",
          "extraction_timeout",
          "service_busy",
          "extraction_failed",
          "file_encrypted",
          "resource_limit_exceeded"
        ],
        "title": "ErrorCode",
        "description": "Machine-readable error codes for all defined failure modes."
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": ["code", "message"],
        "title": "ErrorResponse",
        "description": "Error response body returned for all 4xx/5xx responses from POST /extract."
      },
      "ExtractResponse": {
        "properties": {
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageInfo"
            },
            "type": "array",
            "title": "Pages"
          },
          "mimeType": {
            "type": "string",
            "title": "Mimetype"
          },
          "extractedCharacters": {
            "type": "integer",
            "title": "Extractedcharacters"
          }
        },
        "type": "object",
        "required": ["pages", "mimeType", "extractedCharacters"],
        "title": "ExtractResponse",
        "description": "Successful extraction response returned by POST /extract.\n\nextractedCharacters is the total number of characters (Unicode code points) in content\nacross all pages and is provided for audit logging and metrics purposes."
      },
      "PageInfo": {
        "properties": {
          "pageNumber": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pagenumber"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": ["pageNumber", "label", "content"],
        "title": "PageInfo",
        "description": "Information extracted from a single logical page or section of a document.\n\npageNumber and label are null when the source format has no positional\npage concept (e.g. plain text files)."
      }
    }
  }
}
